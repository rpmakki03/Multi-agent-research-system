# Google Gemini API Key for agent LLM reasoning (e.g. gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here



GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily API Key for real-time web search
